# Environment Variables
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/zan_vn
DATABASE_URL_TEST=postgresql://postgres:password@localhost:5432/zan_vn_test

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-to-a-random-secret
JWT_REFRESH_SECRET=change-me-to-another-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# S3 / Cloudflare R2
S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET=zan-vn-assets
S3_PUBLIC_URL=https://assets.zan-vn.com

# OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# App
API_URL=http://localhost:3001
CLIENT_URL=http://localhost:5173
DASHBOARD_URL=http://localhost:5174
NODE_ENV=development
PORT=3001
